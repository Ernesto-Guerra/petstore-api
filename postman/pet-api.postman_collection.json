{
  "info": {
    "name": "Pet API",
    "description": "Ejercicio tecnico Ssr Backend Developer. Requiere la aplicacion ejecutandose en {{baseUrl}}.\n\nEjecutar las peticiones en orden: el alta siembra la mascota que despues consulta el GET.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "petId", "value": "10000023" }
  ],
  "item": [
    {
      "name": "Add Pet",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/pet", "host": ["{{baseUrl}}"], "path": ["api", "pet"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{petId}},\n  \"status\": \"available\",\n  \"name\": \"testingPet1\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "Registra la mascota en el sistema externo y devuelve el comprobante de la transaccion."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "",
              "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
              "",
              "pm.test('Devuelve la ubicacion del recurso creado', () =>",
              "    pm.expect(pm.response.headers.get('Location')).to.include('/api/pet/' + pm.variables.get('petId')));",
              "",
              "pm.test('transactionId tiene formato UUIDv4', () =>",
              "    pm.expect(body.transactionId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i));",
              "",
              "pm.test('dateCreated es una fecha valida', () =>",
              "    pm.expect(new Date(body.dateCreated).getTime()).to.be.a('number').and.not.NaN);",
              "",
              "pm.test('status indica que el alta fue exitosa', () => pm.expect(body.status).to.eql(true));",
              "",
              "pm.test('name corresponde a la mascota enviada', () => pm.expect(body.name).to.eql('testingPet1'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Pet",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pet/{{petId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "pet", "{{petId}}"]
        },
        "description": "Consulta la mascota en el sistema externo."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "",
              "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
              "",
              "pm.test('Devuelve id, name y status', () =>",
              "    pm.expect(body).to.have.all.keys('id', 'name', 'status'));",
              "",
              "pm.test('Corresponde a la mascota solicitada', () =>",
              "    pm.expect(body.id).to.eql(Number(pm.variables.get('petId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Pet - no existe",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pet/999999999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "pet", "999999999"]
        },
        "description": "La mascota no existe en el sistema externo."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 404 Not Found', () => pm.response.to.have.status(404));",
              "",
              "pm.test('Devuelve un problem detail', () =>",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
              "",
              "pm.test('Identifica el problema', () => pm.expect(pm.response.json().title).to.eql('Mascota no encontrada'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Pet - identificador invalido",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pet/-1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "pet", "-1"]
        },
        "description": "El identificador debe ser un entero positivo; se rechaza antes de llamar al sistema externo."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Responde 400 Bad Request', () => pm.response.to.have.status(400));"]
          }
        }
      ]
    },
    {
      "name": "Add Pet - cuerpo incompleto",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/pet", "host": ["{{baseUrl}}"], "path": ["api", "pet"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 0\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "El cuerpo no cumple las validaciones; la respuesta detalla cada campo invalido."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 400 Bad Request', () => pm.response.to.have.status(400));",
              "",
              "pm.test('Detalla cada campo invalido', () =>",
              "    pm.expect(pm.response.json().errors).to.have.all.keys('id', 'name', 'status'));"
            ]
          }
        }
      ]
    }
  ]
}
